0,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Ejemplo práctico en Python:","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"dHNllGsB4O"}],"key":"JiQIthNgVX"}],"key":"s9heL7IMTV"},{"type":"code","lang":"python","value":"# Ejemplo de conceptos y modos de apertura de archivos\nnombre_archivo = \"registro_estudiantes.txt\"\n\n# 1. Escritura inicial o creación del archivo ('w')\ntry:\n    with open(nombre_archivo, \"w\", encoding=\"utf-8\") as archivo:\n        archivo.write(\"--- Registro Académico UTPL ---\\n\")\n        archivo.write(\"Estudiante: Miguel Téllez\\n\")\n    print(\"Archivo creado y escrito exitosamente en modo 'w'.\")\nexcept Exception as e:\n    print(f\"Error al escribir: {e}\")\n\n# 2. Añadir nueva información sin borrar la anterior ('a')\ntry:\n    with open(nombre_archivo, \"a\", encoding=\"utf-8\") as archivo:\n        archivo.write(\"Materia: Fundamentos de Programación\\n\")\n    print(\"Información agregada exitosamente en modo 'a'.\")\nexcept Exception as e:\n    print(f\"Error al añadir: {e}\")\n\n# 3. Lectura del archivo completo ('r')\ntry:\n    with open(nombre_archivo, \"r\", encoding=\"utf-8\") as archivo:\n        contenido = archivo.read()\n        print(\"\\nContenido actual almacenado en el archivo:\")\n        print(contenido)\nexcept FileNotFoundError:\n    print(\"El archivo especificado no fue encontrado.\")","position":{"start":{"line":12,"column":1},"end":{"line":41,"column":1}},"key":"wGBovTigXb"}],"key":"jXNaz7ys3Z"}],"key":"aKX4Xk4d7F"},{"type":"thematicBreak","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"tTPsFwOGeC"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Hecho por Miguel Camilo Téllez Jara para los compañeros de primer ciclo de la carr