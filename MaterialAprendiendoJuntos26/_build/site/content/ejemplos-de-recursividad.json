ial(numero):\n    # Caso base: detiene la recursión\n    if numero <= 1:\n        return 1\n    # Caso recursivo: llamada a la misma función con estado reducido\n    else:\n        return numero * obtener_factorial(numero - 1)\n\nif __name__ == \"__main__\":\n    res = obtener_factorial(5)\n    print(f\"El factorial de 5 es: {res}\")  # Salida: 120","position":{"start":{"line":7,"column":1},"end":{"line":19,"column":1}},"key":"nin0B1ARmF"}],"key":"SrivPLGl4T"}],"key":"LqUZMKd83f"},{"type":"thematicBreak","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"yNQJP6CPNu"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Hecho por Miguel Camilo Téllez Jara para los compañeros de primer ciclo de la carrera de Ingeniería en Redes y Análisis de Datos, y para el Docente Tutor Mgtr. René Rolando Elizalde Solano. Materia: Fundamentos de Programación, 2026, UTPL.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"vgkfM2pAPo"}],"key":"inAAItAmSP"}],"key":"rBPhflOLM2"}],"key":"Y2tO2QAQIP"}],"key":"D1FhsHSTCG"},"references":{"cite":{"order":[],"data":{}}}}